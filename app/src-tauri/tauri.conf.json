{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Relay for Signal",
  "version": "0.1.0",
  "identifier": "com.bluefishforsale.signalagent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MCP Relay for Signal",
        "width": 560,
        "height": 680,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Terrac Skiens",
    "copyright": "Copyright Terrac Skiens. Licensed under AGPL-3.0-only.",
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/bluefishforsale/signal-agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
