{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MCP Relay for Signal",
  "version": "0.1.0",
  "identifier": "com.bluefishforsale.signalagent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MCP Relay for Signal",
        "width": 560,
        "height": 680,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/bluefishforsale/signal-agent/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCREQ1MDY4QkZBRjlFNEEKUldSS25xKy9hRkRkbTE5TW9SZXA5U3QvRW1zcjRwQjExajlwZ2h2R0M4SG9DVzB3MmV6UDE1WHcK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "publisher": "Terrac Skiens",
    "copyright": "Copyright Terrac Skiens. Licensed under AGPL-3.0-only.",
    "license": "AGPL-3.0-only",
    "homepage": "https://github.com/bluefishforsale/signal-agent",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/signal-agent"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "files": {
        "Library/LaunchAgents/com.bluefishforsale.signalagent.agent.plist": "../../crates/relay-agent/launchd/com.bluefishforsale.signalagent.agent.plist"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
