{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The local setup window: listen for screen changes and call the app's own commands. The captcha window is remote and gets nothing.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-current",
    "allow-send",
    "allow-accounts",
    "allow-add-account",
    "allow-open-captcha",
    "allow-needs-move",
    "allow-move-to-applications",
    "allow-update-offer",
    "allow-install-update",
    "allow-uninstall",
    "allow-remove-account",
    "allow-quit"
  ],
  "local": true
}
